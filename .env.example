# Nomad Agent Configuration

# Fireworks AI API Key (required for LLM operations)
# Get your key at https://fireworks.ai
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Default Fireworks Model
# Common choices:
# - accounts/fireworks/models/llama-v3p3-70b-instruct (Fast, smart, recommended default)
# - accounts/fireworks/models/deepseek-r1 (Deep reasoning model)
# - accounts/fireworks/models/qwen2p5-72b-instruct (High precision coding & reasoning)
# - accounts/fireworks/models/llama-v3p1-8b-instruct (Ultra-fast, lightweight)
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct

# Path to your Obsidian Vault root directory
# (Enables DeepAgent filesystem tools: ls, read_file, edit_file, vault search)
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# Server host and port
NOMAD_HOST=127.0.0.1
NOMAD_PORT=8765

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
